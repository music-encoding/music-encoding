<TEI xmlns="http://www.tei-c.org/ns/1.0"  xmlns:rng="http://relaxng.org/ns/structure/1.0" xmlns:sch="http://purl.oclc.org/dsdl/schematron" xmlns:sch1x="http://www.ascc.net/xml/schematron" xmlns:teix="http://www.tei-c.org/ns/Examples" xmlns:xi="http://www.w3.org/2001/XInclude" >
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title>TEI for authoring MEI ODD</title>
        <!--<author>Sebastian Rahtz</author>
        <author>Raff Viglianti</author>-->
        <author>Benjamin W. Bohl</author>
      </titleStmt>
      <editionStmt>
        <edition>2.0.0</edition>
      </editionStmt>
      <publicationStmt>
        <publisher>Music Encoding Initiative</publisher>
