<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal instance for the `validate-rng` target in build.xml, which needs an instance to compile the
     Schematron rules of a built RNG schema; it must stay valid against these rules (e.g., @meiversion is required). -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="6.0-dev"/>
