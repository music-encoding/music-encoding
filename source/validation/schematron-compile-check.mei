<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal instance for the `validate-schemata` target in build.xml: ph-schematron only compiles a Schematron
     schema while validating an instance, so this file is validated against the Schematron rules extracted from each
     built RNG schema. Its validation result is ignored; only errors in the rules themselves fail the build. -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="6.0-dev"/>
