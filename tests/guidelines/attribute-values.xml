<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader><fileDesc><titleStmt><title>Attribute values regression fixture</title></titleStmt>
        <editionStmt><edition>test</edition></editionStmt></fileDesc></teiHeader>
    <text><body><schemaSpec ident="test">
        <moduleSpec ident="TEST"><desc>Test definitions.</desc></moduleSpec>
        <dataSpec ident="data.TEST" module="TEST"><content><dataRef name="token"/></content></dataSpec>
        <classSpec ident="att.test" type="atts" module="TEST"><attList>
            <attDef ident="named"><desc>Named type.</desc><datatype><dataRef key="data.TEST"/></datatype></attDef>
            <attDef ident="string"><datatype><dataRef name="string"/></datatype></attDef>
            <attDef ident="integer"><datatype><dataRef name="integer"/></datatype></attDef>
            <attDef ident="pattern"><datatype><dataRef name="token"><dataFacet name="pattern" value="[a-g]|unknown"/></dataRef></datatype></attDef>
            <attDef ident="bounds"><datatype><dataRef name="positiveInteger"><dataFacet name="minInclusive" value="2"/><dataFacet name="maxInclusive" value="6"/></dataRef></datatype></attDef>
            <attDef ident="exclusive"><datatype><dataRef name="decimal"><dataFacet name="minExclusive" value="0"/><dataFacet name="maxExclusive" value="10"/></dataRef></datatype></attDef>
            <attDef ident="length"><datatype><dataRef name="string"><dataFacet name="minLength" value="2"/><dataFacet name="maxLength" value="6"/></dataRef></datatype></attDef>
            <attDef ident="multiple"><datatype maxOccurs="unbounded"><dataRef key="data.TEST"/></datatype></attDef>
            <attDef ident="two"><datatype minOccurs="1" maxOccurs="2"><dataRef name="positiveInteger"><dataFacet name="minInclusive" value="2"/></dataRef></datatype></attDef>
            <attDef ident="exact"><datatype minOccurs="3" maxOccurs="3"><dataRef name="integer"/></datatype></attDef>
            <attDef ident="optional"><datatype minOccurs="0" maxOccurs="1"><dataRef name="token"/></datatype></attDef>
            <attDef ident="zeroOrMore"><datatype minOccurs="0" maxOccurs="unbounded"><dataRef name="token"/></datatype></attDef>
            <attDef ident="empty"><datatype minOccurs="0" maxOccurs="0"><dataRef name="token"/></datatype></attDef>
            <attDef ident="bezier"><datatype><sequence minOccurs="1" maxOccurs="unbounded"><dataRef name="decimal"/><dataRef name="decimal"/></sequence></datatype></attDef>
            <attDef ident="bulge"><datatype><sequence minOccurs="1" maxOccurs="unbounded"><dataRef name="decimal"/><dataRef key="data.TEST"/></sequence></datatype></attDef>
            <attDef ident="choice"><datatype><alternate><dataRef name="integer"/><dataRef name="token"/></alternate></datatype></attDef>
            <attDef ident="closed"><valList type="closed"><valItem ident="a"><desc>Alpha.</desc></valItem><valItem ident="b"><desc>Beta.</desc></valItem></valList></attDef>
            <attDef ident="semi"><datatype maxOccurs="unbounded"><dataRef name="NMTOKEN"/></datatype><valList type="semi"><valItem ident="custom"><desc>Suggested token.</desc></valItem></valList></attDef>
            <attDef ident="badConstruct"><datatype><interleave><dataRef name="integer"/></interleave></datatype></attDef>
            <attDef ident="legacy"><datatype><data xmlns="http://relaxng.org/ns/structure/1.0" type="integer"/></datatype></attDef>
            <attDef ident="badFacet"><datatype><dataRef name="token"><dataFacet name="unknown" value="foo"/></dataRef></datatype></attDef>
            <attDef ident="badBounds"><datatype minOccurs="2" maxOccurs="1"><dataRef name="token"/></datatype></attDef>
            <attDef ident="missing"><datatype><dataRef key="data.MISSING"/></datatype></attDef>
            <attDef ident="noDatatype"><desc>No datatype supplied.</desc></attDef>
            <attDef ident="deleted" mode="delete"/>
        </attList></classSpec>
        <elementSpec ident="example" module="TEST"><classes><memberOf key="att.test"/></classes><content><empty/></content></elementSpec>
    </schemaSpec></body></text>
</TEI>
