<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0">
    <teiHeader><fileDesc><titleStmt><title>Content model regression fixture</title></titleStmt>
        <editionStmt><edition>test</edition></editionStmt></fileDesc></teiHeader>
    <text><body><schemaSpec ident="test">
        <moduleSpec ident="TEST"><desc>Test definitions.</desc></moduleSpec>
        <classSpec ident="model.base" type="model" module="TEST"><desc>Base class.</desc></classSpec>
        <classSpec ident="model.left" type="model" module="TEST">
            <classes><memberOf key="model.base"/></classes>
        </classSpec>
        <classSpec ident="model.right" type="model" module="TEST">
            <classes><memberOf key="model.base"/></classes>
        </classSpec>
        <classSpec ident="model.cycleA" type="model" module="TEST">
            <classes><memberOf key="model.cycleB"/></classes>
        </classSpec>
        <classSpec ident="model.cycleB" type="model" module="TEST">
            <classes><memberOf key="model.cycleA"/></classes>
        </classSpec>
        <macroSpec ident="macro.outer" module="TEST">
            <content><sequence><macroRef key="macro.inner"/></sequence></content>
        </macroSpec>
        <macroSpec ident="macro.inner" module="TEST">
            <content><interleave><textNode/><macroRef key="macro.outer"/>
                <classRef key="model.base"/><elementRef key="leaf"/>
            </interleave></content>
        </macroSpec>
        <macroSpec ident="macro.xml" module="TEST">
            <content><anyElement except="urn:excluded urn:also-excluded"/></content>
        </macroSpec>
        <elementSpec ident="parent" module="TEST">
            <content><alternate minOccurs="0" maxOccurs="unbounded">
                <elementRef key="leaf"/><macroRef key="macro.outer"/>
                <elementRef key="unavailable"/>
                <sequence maxOccurs="0"><elementRef key="disabled"/><textNode/></sequence>
            </alternate></content>
        </elementSpec>
        <elementSpec ident="leaf" module="TEST">
            <classes><memberOf key="model.left"/><memberOf key="model.right"/></classes>
            <content><elementRef key="grandchild"/></content>
        </elementSpec>
        <elementSpec ident="grandchild" module="TEST"><content><empty/></content></elementSpec>
        <elementSpec ident="disabled" module="TEST"><content><empty/></content></elementSpec>
        <elementSpec ident="textOnly" module="TEST"><content><textNode/></content></elementSpec>
        <elementSpec ident="empty" module="TEST"><content><empty/></content></elementSpec>
        <elementSpec ident="cycleParent" module="TEST"><content><classRef key="model.cycleA"/></content></elementSpec>
        <elementSpec ident="cycleLeaf" module="TEST">
            <classes><memberOf key="model.cycleB"/></classes><content><empty/></content>
        </elementSpec>
        <elementSpec ident="restricted" module="TEST"><content><macroRef key="macro.xml"/></content></elementSpec>
        <elementSpec ident="unrestricted" module="TEST"><content><anyElement/></content></elementSpec>
        <elementSpec ident="mixedWildcard" module="TEST">
            <content><alternate><macroRef key="macro.xml"/><elementRef key="leaf"/><textNode/></alternate></content>
        </elementSpec>
        <elementSpec ident="inactive" module="TEST">
            <content><sequence maxOccurs="0"><elementRef key="leaf"/><textNode/><anyElement/></sequence></content>
        </elementSpec>
    </schemaSpec></body></text>
</TEI>
