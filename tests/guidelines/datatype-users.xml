<?xml version="1.0" encoding="UTF-8"?>
<TEI xmlns="http://www.tei-c.org/ns/1.0" xmlns:eg="http://www.tei-c.org/ns/Examples">
    <teiHeader><fileDesc><titleStmt><title>Datatype users regression fixture</title></titleStmt>
        <editionStmt><edition>test</edition></editionStmt></fileDesc></teiHeader>
    <text><body><schemaSpec ident="test">
        <moduleSpec ident="TEST"><desc>Test definitions.</desc></moduleSpec>
        <dataSpec ident="data.TARGET" module="TEST"><content><dataRef name="token"/></content></dataSpec>
        <dataSpec ident="data.EMPTY" module="TEST"><content><dataRef name="integer"/></content></dataSpec>
        <dataSpec ident="data.BYREF" module="TEST">
            <content><alternate><dataRef key="data.TARGET"/><dataRef key="data.TARGET"/><macroRef key="data.TARGET"/></alternate></content>
        </dataSpec>
        <dataSpec ident="data.BYMACRO" module="TEST"><content><macroRef key="data.TARGET"/></content></dataSpec>
        <dataSpec ident="data.TRANSITIVE" module="TEST"><content><dataRef key="data.BYREF"/></content></dataSpec>
        <dataSpec ident="data.DOCUMENTATION" module="TEST">
            <content><valList type="closed"><valItem ident="sample"><desc>
                <eg:egXML><dataRef key="data.TARGET"/><macroRef key="data.TARGET"/></eg:egXML>
            </desc></valItem></valList></content>
            <remarks><eg:egXML><dataRef key="data.TARGET"/></eg:egXML></remarks>
        </dataSpec>
        <dataSpec ident="data.DISABLED" module="TEST">
            <content><sequence minOccurs="0" maxOccurs="0"><dataRef key="data.TARGET"/><macroRef key="data.TARGET"/></sequence></content>
        </dataSpec>
        <dataSpec ident="data.DELETED" module="TEST" mode="delete"><content><dataRef key="data.TARGET"/></content></dataSpec>
        <!-- @name is not a named datatype reference, even if its text matches. -->
        <dataSpec ident="data.BUILTIN" module="TEST"><content><dataRef name="data.TARGET"/></content></dataSpec>
        <dataSpec ident="data.SELF" module="TEST"><content><alternate><macroRef key="data.SELF"/><dataRef key="data.SELF"/></alternate></content></dataSpec>
        <classSpec ident="att.users" type="atts" module="TEST"><attList>
            <attDef ident="zeta"><desc>Repeated reference.</desc><datatype><sequence><dataRef key="data.TARGET"/><dataRef key="data.TARGET"/></sequence></datatype></attDef>
            <attList><attDef ident="alpha"><desc>Grouped attribute.</desc><datatype><dataRef key="data.TARGET"/></datatype></attDef></attList>
            <attDef ident="builtin"><datatype><dataRef name="data.TARGET"/></datatype></attDef>
            <attDef ident="documented"><desc><eg:egXML><dataRef key="data.TARGET"/></eg:egXML></desc><datatype><dataRef name="integer"/></datatype></attDef>
            <attDef ident="deleted" mode="delete"><datatype><dataRef key="data.TARGET"/></datatype></attDef>
            <attDef ident="disabled"><datatype minOccurs="0" maxOccurs="0"><dataRef key="data.TARGET"/></datatype></attDef>
        </attList></classSpec>
        <classSpec ident="att.deleted" type="atts" module="TEST" mode="delete"><attList>
            <attDef ident="value"><datatype><dataRef key="data.TARGET"/></datatype></attDef>
        </attList></classSpec>
        <elementSpec ident="local" module="TEST"><attList>
            <attDef ident="beta"><desc>Local sequence.</desc><datatype><sequence><dataRef key="data.TARGET"/><dataRef key="data.TARGET"/></sequence></datatype></attDef>
            <attDef ident="alpha"><desc>Local attribute.</desc><datatype><dataRef key="data.TARGET"/></datatype></attDef>
            <attDef ident="deleted" mode="delete"><datatype><dataRef key="data.TARGET"/></datatype></attDef>
            <attDef ident="disabled"><datatype><sequence minOccurs="0" maxOccurs="0"><dataRef key="data.TARGET"/></sequence><dataRef name="integer"/></datatype></attDef>
        </attList><content><empty/></content></elementSpec>
        <elementSpec ident="inheritedOnly" module="TEST"><classes><memberOf key="att.users"/></classes><content><empty/></content></elementSpec>
        <elementSpec ident="documentedOnly" module="TEST"><desc><eg:egXML><dataRef key="data.TARGET"/></eg:egXML></desc><content><empty/></content></elementSpec>
        <elementSpec ident="deletedElement" module="TEST" mode="delete"><attList>
            <attDef ident="value"><datatype><dataRef key="data.TARGET"/></datatype></attDef>
        </attList><content><empty/></content></elementSpec>
    </schemaSpec></body></text>
</TEI>
