<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../dist/schemata/mei-all.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<?xml-model href="../../dist/schemata/mei-all.rng" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<!-- Test for MEI.watermark: sign, context and collection method. -->
<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="6.0-dev">
    <meiHead>
        <fileDesc>
            <titleStmt>
                <title>Watermark description with MEI.watermark</title>
                <respStmt>
                    <resp>encoding</resp>
                    <persName xml:id="encoder">N. N.</persName>
                </respStmt>
            </titleStmt>
            <pubStmt/>
        </fileDesc>
        <encodingDesc>
            <appInfo>
                <application xml:id="assistant">
                    <name>Watermark assistant (suggestion confirmed by the encoder)</name>
                </application>
            </appInfo>
            <classDecls>
                <taxonomy xml:id="wzis">
                    <head>WZIS motif classification</head>
                    <category xml:id="wzis-004001003002011003001">
                        <desc>Motif class of the main mark (WZIS code)</desc>
                    </category>
                    <category xml:id="wzis-011004006007">
                        <desc>Motif class of the countermark (WZIS code)</desc>
                    </category>
                </taxonomy>
            </classDecls>
        </encodingDesc>
        <manifestationList>
            <manifestation singleton="true">
                <identifier>A-Wn, Mus.Hs.27666</identifier>
                <physDesc>
                    <watermarkDesc>
                        <watermarkList>
                            <!-- sign -->
                            <watermark xml:id="wm-00004" wmtype="main" wmstruct="LW" completeness="true">
                                <title>Type I-2.B – Welhartiz</title>
                                <locus>fols. 1–2 and 7–8</locus>
                                <fig>
                                    <figDesc>
                                        <heraldry xml:id="mainMark" type="mainMark" class="#wzis-004001003002011003001">
                                            Shield with a bend, above it a fleur-de-lis, below it JAA
                                            <relation rel="hasCountermark" target="#countermark"/>
                                        </heraldry>
                                        <heraldry xml:id="countermark" type="countermark" class="#wzis-011004006007">
                                            Lettering WELHARTIEZ, mirror-inverted
                                            <relation rel="isCountermarkOf" target="#mainMark"/>
                                        </heraldry>
                                    </figDesc>
                                </fig>
                                <relation rel="hasTwin" target="#wm-00003"/>
                                <!-- context -->
                                <datingEvid evidence="external">
                                    <usagePeriod>
                                        <date startdate="1819" enddate="1820"/>
                                    </usagePeriod>
                                </datingEvid>
                                <relation rel="isProductOf" target="#mold-I-2.B"/>
                                <!-- collection method -->
                                <collectionMethod resp="#encoder">
                                    <reproTech repro="therm"/>
                                    <examinationSide side="mold"/>
                                    <moldMeasurement quadrant="a">
                                        <chainLinesDistance unit="mm" aggregate="median">30.663</chainLinesDistance>
                                        <laidLinesDensity unit="mm" segment="20" resp="#assistant">12.36</laidLinesDensity>
                                    </moldMeasurement>
                                </collectionMethod>
                            </watermark>
                            <watermark xml:id="wm-00003" wmtype="main" wmstruct="LW">
                                <title>Twin of type I-2.B</title>
                                <relation rel="hasTwin" target="#wm-00004"/>
                            </watermark>
                            <!-- semi-open list: project-specific value -->
                            <watermark xml:id="wm-00005" wmtype="additionalMark"/>
                        </watermarkList>
                        <paperMoldDesc>
                            <paperMold xml:id="mold-I-2.B">
                                <paperMoldFormat height="340" width="420" unit="mm">Kanzlei</paperMoldFormat>
                                <moldStructure twin="true">
                                    <quadrant quadrant="a">
                                        <locus>fol. 1</locus>
                                    </quadrant>
                                </moldStructure>
                                <datingEvid evidence="conjecture">
                                    <prodPeriod>
                                        <date notbefore="1815" notafter="1820"/>
                                    </prodPeriod>
                                </datingEvid>
                                <relation rel="isProductOf" target="#pm-00004"/>
                            </paperMold>
                        </paperMoldDesc>
                        <papermillDesc>
                            <papermill xml:id="pm-00004">
                                <title>Welhartiz paper mill</title>
                                <identifier auth="GND" codedval="1042802734"/>
                                <geogName type="place">
                                    <name xml:lang="de">Welhartiz</name>
                                    <name xml:lang="cs">Velhartice</name>
                                    <geogFeat>locality</geogFeat>
                                </geogName>
                                <papermaker>
                                    <persName>Josef Anton Appeltauer</persName>
                                    <date startdate="1807" enddate="1851"/>
                                </papermaker>
                                <history>
                                    <eventList>
                                        <event>
                                            <date startdate="1807" enddate="1851"/>
                                            <desc>Takeover by Josef Anton Appeltauer</desc>
                                        </event>
                                    </eventList>
                                </history>
                            </papermill>
                        </papermillDesc>
                    </watermarkDesc>
                </physDesc>
            </manifestation>
        </manifestationList>
    </meiHead>
    <music/>
</mei>
